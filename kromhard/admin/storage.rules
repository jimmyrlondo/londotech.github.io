rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product photos. Publicly readable (the catalog page displays them to
    // anyone); writable only by a signed-in user. There is no public sign-up
    // flow in this app - every Auth account is created manually for actual
    // Kromhard staff - so "signed in" is already a meaningful gate here,
    // backed by the stricter admins/{uid} allow-list on the Firestore side
    // that controls whether an upload's resulting URL ever gets attached
    // to a real product.
    match /product-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
